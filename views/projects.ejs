<%- include('partials/head', { page, site, currentPath: '/projects' }) %>
<%- include('partials/header', { currentPath: '/projects' }) %>

<main id="main" class="wrap">
  <header class="page-head">
    <p class="kicker">Projects</p>
    <h1>Projects &amp; publications</h1>
    <p class="lede">Infrastructure, backend, and research work. Filter by area below.</p>
  </header>

  <section class="callout" aria-label="Publication">
    <p class="kicker">Publication · arXiv:2508.16024</p>
    <h2>Wavelet-Driven Neural Super-Resolution for Real-Time Rendering</h2>
    <ul>
      <li>Researched and implemented a wavelet-based neural super-resolution method for rendered frame quality enhancement.</li>
      <li>Developed a Fourier-Mapped INR module for high-frequency detail reconstruction in real-time rendering.</li>
      <li>Designed a feature extraction pipeline using HR G-buffers, temporal frames, and BRDF-based lighting decomposition.</li>
      <li>Achieved PSNR: 36.8 dB, LPIPS: 0.059, and SSIM: 0.960, outperforming other SR methods.</li>
      <li>Currently in review at Computers and Graphics journal with arXiv preprint available.</li>
    </ul>
  </section>

  <% const types = [...new Set(projects.map((project) => project.type))]; %>
  <div class="filter-bar" role="group" aria-label="Filter projects">
    <button type="button" class="chip is-active" data-filter="">all <span><%= projects.length %></span></button>
    <% types.forEach((type) => { %>
      <button type="button" class="chip" data-filter="<%= type %>"><%= type.toLowerCase() %></button>
    <% }) %>
  </div>

  <section class="project-list" id="projectList" aria-label="Project list">
    <% if (!projects.length) { %>
      <p class="muted">No projects found.</p>
    <% } %>
    <% projects.forEach((project) => { %>
      <article class="project-row" data-type="<%= project.type %>">
        <p class="project-meta"><%= project.year %> · <%= project.type %></p>
        <h2><%= project.title %></h2>
        <p><%= project.summary %></p>
        <p class="stack"><% project.stack.forEach((tech) => { %><span><%= tech %></span><% }) %></p>
      </article>
    <% }) %>
  </section>
</main>

<%- include('partials/footer') %>
