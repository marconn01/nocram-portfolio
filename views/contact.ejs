<%- include('partials/head', { page, site, currentPath: '/contact' }) %>
<%- include('partials/header', { currentPath: '/contact' }) %>

<main id="main" class="wrap">
  <header class="page-head">
    <p class="kicker">Contact</p>
    <h1>Send a message.</h1>
    <p class="lede">Reach out for backend engineering, DevOps automation, or cloud deployment collaborations.</p>
  </header>

  <section class="contact-layout">
    <form id="contactForm" class="form" novalidate>
      <label for="name">Name</label>
      <input id="name" name="name" type="text" required minlength="2" autocomplete="name" />

      <label for="email">Email</label>
      <input id="email" name="email" type="email" required autocomplete="email" />

      <label for="subject">Subject</label>
      <input id="subject" name="subject" type="text" required minlength="4" />

      <label for="message">Message</label>
      <textarea id="message" name="message" rows="7" required minlength="12"></textarea>

      <div class="form-foot">
        <button type="submit" class="btn btn-primary">Send message</button>
        <p id="formStatus" class="form-status" aria-live="polite"></p>
      </div>
    </form>

    <dl class="spec" aria-label="Direct contact">
      <div><dt>email</dt><dd><a href="mailto:navinkhanal3@gmail.com">navinkhanal3@gmail.com</a></dd></div>
      <div><dt>phone</dt><dd><a href="tel:+9779868265503">+977 9868265503</a></dd></div>
      <div><dt>location</dt><dd>Kathmandu, Nepal</dd></div>
      <div><dt>github</dt><dd><a href="https://github.com/marconn01" target="_blank" rel="noopener">marconn01</a></dd></div>
      <div><dt>linkedin</dt><dd><a href="https://www.linkedin.com/in/navin-nepal/" target="_blank" rel="noopener">navin-nepal</a></dd></div>
      <div><dt>reply</dt><dd>usually within 24 hours</dd></div>
    </dl>
  </section>
</main>

<%- include('partials/footer') %>
