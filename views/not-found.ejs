<%- include('partials/head', { page, site, currentPath: '/404' }) %>
<%- include('partials/header', { currentPath: '/404' }) %>

<main id="main" class="wrap">
  <header class="page-head not-found">
    <p class="kicker">HTTP 404</p>
    <h1>No route to host.</h1>
    <p class="lede">The page you're looking for doesn't exist or has moved.</p>
    <pre class="term-inline"><span class="term-prompt">$</span> curl -I <%= currentUrl %>
HTTP/2 404</pre>
    <div class="actions">
      <a href="/" class="btn btn-primary">Back home</a>
      <a href="/blog" class="btn">Browse writing</a>
    </div>
  </header>
</main>

<%- include('partials/footer') %>
