<%- include('partials/head', { page, site, currentPath: '/' }) %>
<%- include('partials/header', { currentPath: '/' }) %>

<main id="main" class="wrap">
  <section class="hero">
    <div class="hero-text">
      <p class="kicker">DevOps · SRE · Platform engineering</p>
      <h1>Building reliable, scalable cloud systems.</h1>
      <p class="lede">
        I'm Navin, an engineer working across DevOps, SRE, and backend architecture:
        AWS, Kubernetes, Terraform, and Python services. I write here about what I build,
        break, and learn along the way.
      </p>
      <div class="actions">
        <a href="/blog" class="btn btn-primary">Read the writing</a>
        <a href="/projects" class="btn">Projects</a>
        <a href="/cv" class="btn">CV</a>
      </div>
    </div>

    <dl class="spec" aria-label="Profile">
      <div><dt>role</dt><dd>DevOps &amp; backend engineer</dd></div>
      <div><dt>based</dt><dd>Imadol, Lalitpur, NP</dd></div>
      <div><dt>stack</dt><dd>AWS · K8s · Terraform · Python</dd></div>
      <div><dt>focus</dt><dd>CI/CD, reliability, observability</dd></div>
      <div><dt>email</dt><dd><a href="mailto:navinkhanal3@gmail.com">navinkhanal3@gmail.com</a></dd></div>
      <div><dt>phone</dt><dd><a href="tel:+9779868265503">+977 9868265503</a></dd></div>
      <div><dt>links</dt><dd><a href="https://github.com/marconn01" target="_blank" rel="noopener">github</a> · <a href="https://www.linkedin.com/in/navin-nepal/" target="_blank" rel="noopener">linkedin</a></dd></div>
    </dl>
  </section>

  <%- include('partials/pipeline') %>

  <section class="section" aria-labelledby="focus-heading">
    <header class="section-head">
      <h2 id="focus-heading"><span class="sec-no">01</span>What I work on</h2>
    </header>
    <div class="focus-grid">
      <article>
        <h3>DevOps</h3>
        <p>CI/CD pipelines, release safety, and automation practices for fast and stable delivery.</p>
      </article>
      <article>
        <h3>Cloud engineering</h3>
        <p>AWS infrastructure design with Terraform, load balancing, observability, and cost-aware scaling.</p>
      </article>
      <article>
        <h3>Backend systems</h3>
        <p>FastAPI and Django services built for maintainability, performance, and clean operational workflows.</p>
      </article>
    </div>
  </section>

  <section class="section" aria-labelledby="writing-heading">
    <header class="section-head">
      <h2 id="writing-heading"><span class="sec-no">02</span>Recent writing</h2>
      <a href="/blog" class="more">all posts →</a>
    </header>
    <% if (!latestPosts.length) { %>
      <p class="muted">Nothing published yet. First post coming soon.</p>
    <% } %>
    <div class="tiles">
      <% latestPosts.forEach((post) => { %>
        <%- include('partials/post-tile', { post }) %>
      <% }) %>
    </div>
  </section>

  <section class="section" aria-labelledby="work-heading">
    <header class="section-head">
      <h2 id="work-heading"><span class="sec-no">03</span>Selected work</h2>
      <a href="/projects" class="more">all projects →</a>
    </header>
    <div class="project-list">
      <% featured.forEach((project) => { %>
        <article class="project-row">
          <p class="project-meta"><%= project.year %> · <%= project.type %></p>
          <h3><%= project.title %></h3>
          <p><%= project.summary %></p>
          <p class="stack"><% project.stack.forEach((tech) => { %><span><%= tech %></span><% }) %></p>
        </article>
      <% }) %>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
